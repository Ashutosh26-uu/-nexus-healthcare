# ===== Sehatra — production settings =====
# Copy to .env.production and fill in. Never commit the real file.

NODE_ENV=production
PORT=8080

# A clean network for real users. (DATA_MODE=demo loads the Barabanki demo with Demo@123 accounts.)
DATA_MODE=live
# The first super-admin, created on the very first start. Use a long, unique password and change it after login.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
ADMIN_NAME=Sehatra Admin

# REQUIRED — 48+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional separate secrets (default to JWT_SECRET): one-time codes and emergency capsules
# OTP_SECRET=
# CAPSULE_SECRET=

# Your public address(es), comma-separated, if the API is called from another origin (e.g. a mobile wrapper).
CORS_ORIGIN=https://yourdomain.com

# Database — leave empty for SQLite on the mounted volume, or point at PostgreSQL (docker-compose sets this for you).
# DATABASE_URL=postgres://user:password@host:5432/nexus?sslmode=require

# ----- One-time codes -----
# Email (works today with your Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sehatra <your-otp-address@gmail.com>"
# SMS for India: MSG91 (needs DLT-registered template) — or Twilio for global numbers.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Never true in production (it shows codes on screen).
OTP_DEV_MODE=false

# ----- Payments -----
# Razorpay (UPI, cards, netbanking) — create keys at dashboard.razorpay.com. Without them, bookings use demo payments.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Your UPI ID for the scan-to-pay QR (shown only when set)
# UPI_VPA=yourbusiness@okicici
# UPI_PAYEE_NAME=Sehatra
# Allow the "demo: mark as paid" button on a live network (keep false for real users)
ALLOW_DEMO_PAYMENTS=false

# Optional: Claude for the Saathi assistant and live translation
# ANTHROPIC_API_KEY=
