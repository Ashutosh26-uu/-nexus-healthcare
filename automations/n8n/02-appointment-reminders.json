{
  "name": "Sehatra · Appointment & lab reminders (WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "a563eb5f-c269-4edb-b587-3b24cb626ebc",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "be30d040-523e-4d01-a798-5bedf5978da5",
              "name": "baseUrl",
              "value": "https://sehatra-50046997916.development.catalystappsail.in",
              "type": "string"
            },
            {
              "id": "adb95098-0515-4f07-830c-45bd0af69fdf",
              "name": "alertEmail",
              "value": "you@yourdomain.com",
              "type": "string"
            },
            {
              "id": "33f7661d-522f-4734-8718-c0d15f369d35",
              "name": "fromEmail",
              "value": "Sehatra Automations <no-reply@yourdomain.com>",
              "type": "string"
            },
            {
              "id": "afcdd7dc-244c-4d06-91b7-98dbdfb54c9b",
              "name": "whatsappFrom",
              "value": "+14155238886",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "7f3dadfc-a7eb-4822-9da1-d22f27efbffb",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Edit these once: your Sehatra URL, who gets alerts, and the sender address."
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/upcoming?hours=24",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "890854a6-0fcf-40af-bb8c-a30ad366bebc",
      "name": "Upcoming visits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nexusAutomationKey",
          "name": "Sehatra automation key"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "5ba20d40-eb3e-48de-8f6d-446d417600a8",
      "name": "One per visit",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const toE164 = (m) => { const d = String(m || '').replace(/\\D/g, ''); return d.length === 10 ? '+91' + d : d ? '+' + d : null; };\n// Reminder text for each upcoming visit or lab slot. Skips demo data and anyone without a mobile number.\nconst live = $('Upcoming visits').first().json.mode === 'live';\nconst out = [];\nfor (const item of $input.all()) {\n  const v = item.json;\n  const c = v.contact || {};\n  if (!live || !c.mobile) continue;\n  const hi = c.firstName ? `Hi ${c.firstName}, ` : 'Hi, ';\n  const text = v.kind === 'lab'\n    ? `${hi}reminder: your test at ${v.labName} is on ${v.when}.${v.homeCollection ? ' A technician will come to your home.' : ''}${v.fastingNeeded ? ' Please don’t eat for 8–10 hours before (water is fine).' : ''} Pay ₹${v.balance} at the lab.`\n    : `${hi}reminder: your ${v.followUp ? 'follow-up ' : ''}appointment with ${v.doctorName} is on ${v.when}${v.mode === 'in_person' ? ` at ${v.location}. Show your visit QR at the reception.` : `. It’s a ${v.mode} consult — open the Sehatra app a few minutes early.`}`;\n  out.push({ json: { to: toE164(c.mobile), message: `${text} — Sehatra`, kind: v.kind, id: v.id } });\n}\nreturn out;"
      },
      "id": "2bc5b9e3-4c69-49a9-9a8f-0ee46a787ab6",
      "name": "Write reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "from": "={{ $('Config').first().json.whatsappFrom }}",
        "to": "={{ $json.to }}",
        "toWhatsapp": true,
        "message": "={{ $json.message }}",
        "options": {}
      },
      "id": "e770e41d-c503-424f-b1f6-ff38768f7e12",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "twilioApi": {
          "id": "nexusTwilio",
          "name": "Twilio (WhatsApp)"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Needs a Twilio WhatsApp sender. Swap for MSG91/Gupshup/Interakt if you prefer."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/reminded",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: $('Write reminder').item.json.kind, id: $('Write reminder').item.json.id, channel: 'whatsapp' }) }}",
        "options": {}
      },
      "id": "0f21999c-0dab-45a4-978c-0f8f02ec7038",
      "name": "Mark reminded",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nexusAutomationKey",
          "name": "Sehatra automation key"
        }
      },
      "notes": "So the next run does not remind the same person again."
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Upcoming visits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upcoming visits": {
      "main": [
        [
          {
            "node": "One per visit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One per visit": {
      "main": [
        [
          {
            "node": "Write reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write reminder": {
      "main": [
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp": {
      "main": [
        [
          {
            "node": "Mark reminded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Every 30 minutes: WhatsApp reminders for doctor visits and lab slots in the next 24 hours, once each. Needs N8N_SHARE_CONTACT=true on the server."
  },
