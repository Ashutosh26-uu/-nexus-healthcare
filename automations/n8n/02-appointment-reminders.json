{
  "name": "Nexus · Appointment & lab reminders (WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "70ee2140-2645-4b80-bc1b-6bdccd321ced",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "93e88625-2eae-4849-b356-7f69df8e61b4",
              "name": "baseUrl",
              "value": "https://nexus-healthcare-50042935756.development.catalystappsail.in",
              "type": "string"
            },
            {
              "id": "3fb30c2a-13b7-4274-946b-29626ae022c2",
              "name": "alertEmail",
              "value": "you@yourdomain.com",
              "type": "string"
            },
            {
              "id": "68484f96-9d8c-45ea-916f-988dab109f48",
              "name": "fromEmail",
              "value": "Nexus Automations <no-reply@yourdomain.com>",
              "type": "string"
            },
            {
              "id": "fdbe99cf-47a5-4cbb-82c6-4f4b597dfe6a",
              "name": "whatsappFrom",
              "value": "+14155238886",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5d1833a8-339b-4c70-be9a-e375076d4bce",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Edit these once: your Nexus URL, who gets alerts, and the sender address."
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/upcoming?hours=24",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "06c834d9-6840-47f1-ac3d-66f3d47c82f6",
      "name": "Upcoming visits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nexusAutomationKey",
          "name": "Nexus automation key"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "c9c3534e-dc57-4cac-8fa5-c1ded6bff213",
      "name": "One per visit",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const toE164 = (m) => { const d = String(m || '').replace(/\\D/g, ''); return d.length === 10 ? '+91' + d : d ? '+' + d : null; };\n// Reminder text for each upcoming visit or lab slot. Skips demo data and anyone without a mobile number.\nconst live = $('Upcoming visits').first().json.mode === 'live';\nconst out = [];\nfor (const item of $input.all()) {\n  const v = item.json;\n  const c = v.contact || {};\n  if (!live || !c.mobile) continue;\n  const hi = c.firstName ? `Hi ${c.firstName}, ` : 'Hi, ';\n  const text = v.kind === 'lab'\n    ? `${hi}reminder: your test at ${v.labName} is on ${v.when}.${v.homeCollection ? ' A technician will come to your home.' : ''}${v.fastingNeeded ? ' Please don’t eat for 8–10 hours before (water is fine).' : ''} Pay ₹${v.balance} at the lab.`\n    : `${hi}reminder: your ${v.followUp ? 'follow-up ' : ''}appointment with ${v.doctorName} is on ${v.when}${v.mode === 'in_person' ? ` at ${v.location}. Show your visit QR at the reception.` : `. It’s a ${v.mode} consult — open the Nexus app a few minutes early.`}`;\n  out.push({ json: { to: toE164(c.mobile), message: `${text} — Nexus Healthcare`, kind: v.kind, id: v.id } });\n}\nreturn out;"
      },
      "id": "c2f56974-9c77-4db2-a1b6-fcdb8ec96352",
      "name": "Write reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "from": "={{ $('Config').first().json.whatsappFrom }}",
        "to": "={{ $json.to }}",
        "toWhatsapp": true,
        "message": "={{ $json.message }}",
        "options": {}
      },
      "id": "aacea8f7-b96b-4f0d-8991-4dab5700883b",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "twilioApi": {
          "id": "nexusTwilio",
          "name": "Twilio (WhatsApp)"
        }
      },
      "notes": "Needs a Twilio WhatsApp sender. Swap for MSG91/Gupshup/Interakt if you prefer."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/reminded",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: $('Write reminder').item.json.kind, id: $('Write reminder').item.json.id, channel: 'whatsapp' }) }}",
        "options": {}
      },
      "id": "b8aafc77-1e4e-4129-8a00-494f07b3857c",
      "name": "Mark reminded",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nexusAutomationKey",
          "name": "Nexus automation key"
        }
      },
      "notes": "So the next run does not remind the same person again."
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Upcoming visits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upcoming visits": {
      "main": [
        [
          {
            "node": "One per visit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One per visit": {
      "main": [
        [
          {
            "node": "Write reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write reminder": {
      "main": [
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp": {
      "main": [
        [
          {
            "node": "Mark reminded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Every 30 minutes: WhatsApp reminders for doctor visits and lab slots in the next 24 hours, once each. Needs N8N_SHARE_CONTACT=true on the server."
  },
