{
  "name": "Sehatra · Daily report (email)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "496525fe-c194-4e35-8338-d02ca25c0059",
      "name": "Every morning 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "87bb43da-32b7-4eaa-9252-0e1beea97513",
              "name": "baseUrl",
              "value": "https://nexus-healthcare-50042935756.development.catalystappsail.in",
              "type": "string"
            },
            {
              "id": "4011dd9e-9a1f-405c-a301-84bb08daf46a",
              "name": "alertEmail",
              "value": "you@yourdomain.com",
              "type": "string"
            },
            {
              "id": "45c35dbe-a0ec-4a0f-bd90-b39626f0a372",
              "name": "fromEmail",
              "value": "Sehatra Automations <no-reply@yourdomain.com>",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "256c36df-5006-4202-899b-4fe46fa5d00f",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Edit these once: your Sehatra URL, who gets alerts, and the sender address."
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "7bf21798-044e-49a0-bceb-b84d2212ab6d",
      "name": "Yesterday's numbers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nexusAutomationKey",
          "name": "Sehatra automation key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst rupee = (n) => '₹' + Number(n || 0).toLocaleString('en-IN');\nconst lines = [\n  `Sehatra — ${s.date}${s.mode !== 'live' ? ' (demo data)' : ''}`,\n  '',\n  `New patients: ${s.patients.new}  (total ${s.patients.total})`,\n  `Doctor bookings: ${s.consults.booked} · consults done: ${s.consults.completed} · follow-ups booked: ${s.consults.followUpsBooked}`,\n  `Prescriptions: ${s.prescriptions}`,\n  `Lab tests: ${s.labs.advised} advised · ${s.labs.booked} booked · ${s.labs.reported} reported${s.labs.critical ? ` · ${s.labs.critical} CRITICAL` : ''}`,\n  `Medicine orders: ${s.medicineOrders.placed} placed · ${s.medicineOrders.delivered} delivered/collected · ${s.medicineOrders.declined} declined · ${s.medicineOrders.cancelled} cancelled`,\n  `Payments: ${s.payments.count} · ${rupee(s.payments.amount)}`,\n  ...Object.entries(s.payments.byPurpose || {}).map(([k, v]) => `   ${k}: ${rupee(v)}`),\n  '',\n  `Refunds waiting: ${s.refundsPending}`,\n  `Waiting for verification: ${s.awaitingVerification.doctors} doctors, ${s.awaitingVerification.facilities} facilities`,\n];\nreturn [{ json: { subject: `Sehatra daily report — ${s.date}: ${s.consults.booked} bookings, ${rupee(s.payments.amount)}`, text: lines.join('\\n') } }];"
      },
      "id": "bff23e08-0ae0-45c2-89ba-90615ff91f73",
      "name": "Write report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.fromEmail }}",
        "toEmail": "={{ $('Config').first().json.alertEmail }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "ae175d80-43bd-473a-89e8-95f035231d16",
      "name": "Email report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "nexusSmtp",
          "name": "SMTP (alerts)"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every morning 8:00": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Yesterday's numbers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Yesterday's numbers": {
      "main": [
        [
          {
            "node": "Write report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write report": {
      "main": [
        [
          {
            "node": "Email report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Every morning at 8:00 IST: yesterday's bookings, tests, medicine orders, payments, refunds and pending verifications by email."
  },
  "tags": []
}
