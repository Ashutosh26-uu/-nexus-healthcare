    {
      "parameters": {
        "jsCode": "const when = (iso) => iso ? new Date(iso).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) : 'now';\nconst toE164 = (m) => { const d = String(m || '').replace(/\\D/g, ''); return d.length === 10 ? '+91' + d : d ? '+' + d : null; };\n// One WhatsApp line per event. Demo data is never messaged (its phone numbers may belong to real people).\nconst out = [];\nfor (const item of $input.all()) {\n  const e = item.json.body || {};\n  const d = e.data || {};\n  const c = d.contact || {};\n  if (e.mode !== 'live' || !c.mobile) continue;\n  const hi = c.firstName ? `Hi ${c.firstName}, ` : 'Hi, ';\n  const text = {\n    'booking.confirmed': `${hi}your appointment with ${d.doctorName} is confirmed — ${d.mode === 'in_person' ? `at ${d.location}` : `${d.mode} consult`}, ${when(d.scheduledAt)}.`,\n    'followup.scheduled': `${hi}${d.doctorName} has booked a follow-up for you on ${when(d.scheduledAt)}${d.location ? ` at ${d.location}` : ' (video)'}.`,\n    'lab.booked': `${hi}your test at ${d.labName} is booked${d.slot ? ` for ${when(d.slot)}` : ''}. ₹${d.advancePaid} paid — ₹${d.balance} at the lab.${d.homeCollection ? ' A technician will come to your home.' : ''}`,\n    'lab.sample_collected': `${hi}your sample was collected at ${d.labName}. Your report should be ready by ${when(d.reportDueAt)}.`,\n    'lab.report_ready': d.critical ? `${hi}one of your results needs attention. Your doctor has been told and will contact you. Please open the Sehatra app.` : `${hi}your lab report from ${d.labName} is ready in the Sehatra app — online and as a PDF, with what to do next.`,\n    'medicine_order.updated': d.status === 'accepted' ? `${hi}${d.pharmacyName} accepted your medicine order ${d.orderNo}.` : d.status === 'declined' ? `${hi}order ${d.orderNo} couldn't be accepted. Please try another chemist in the app.` : null,\n    'medicine_order.delivered': `${hi}your medicines (${d.orderNo}) were delivered. Get well soon!`,\n  }[e.event];\n  if (!text) continue;\n  out.push({ json: { to: toE164(c.mobile), message: `${text} — Sehatra`, event: e.event, eventId: e.id } });\n}\nreturn out;"
      },
