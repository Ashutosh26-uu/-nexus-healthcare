{
  "name": "Sehatra · Low stock & expiry alert (email)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "7e4bce12-23da-4ae9-ab6c-7904e37988b0",
      "name": "Every day 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ad98c371-197f-4d6d-a03a-7d63697cf562",
              "name": "baseUrl",
              "value": "https://sehatra-50047089327.development.catalystappsail.in",
              "type": "string"
            },
            {
              "id": "557181e0-be8f-4295-90f1-7e99e38ae37b",
              "name": "alertEmail",
              "value": "you@yourdomain.com",
              "type": "string"
            },
            {
              "id": "4fbff6b1-0d4d-4164-93b9-b4f36799e3f5",
              "name": "fromEmail",
              "value": "Sehatra Automations <no-reply@yourdomain.com>",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "ff986850-a65f-4fe6-bae4-abcb3c81aa21",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Edit these once: your Sehatra URL, who gets alerts, and the sender address."
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.baseUrl }}/api/automation/low-stock",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "f72544d7-ce88-40e9-8588-9633c60591ad",
      "name": "Low stock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nexusAutomationKey",
          "name": "Sehatra automation key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const { stores } = $input.first().json;\nif (!stores.length) return [];\nconst text = stores.map((s) => [\n  `${s.name}${s.district ? `, ${s.district}` : ''}${s.phone ? ` · ${s.phone}` : ''}`,\n  ...s.low.map((i) => `   LOW  ${i.drug}: ${i.qty} left (keep ${i.safetyStock})`),\n  ...s.expiringSoon.map((i) => `   EXPIRES ${i.expiry}  ${i.drug} · ${i.qty} units · batch ${i.batch}`),\n].join('\\n')).join('\\n\\n');\nreturn [{ json: { subject: `Stock alert — ${stores.length} chemist${stores.length > 1 ? 's' : ''} need attention`, text } }];"
      },
      "id": "4d34797d-a256-4972-870d-c37eb66bcd14",
      "name": "Write alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "notes": "Returns nothing when every store is fine, so no email goes out."
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.fromEmail }}",
        "toEmail": "={{ $('Config').first().json.alertEmail }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "58012964-1fe0-45bb-b242-a1b4de51f86f",
      "name": "Email alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "nexusSmtp",
          "name": "SMTP (alerts)"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every day 9:00": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Low stock",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Low stock": {
      "main": [
        [
          {
            "node": "Write alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write alert": {
      "main": [
        [
          {
            "node": "Email alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Every day at 9:00 IST: chemists running below safety stock or holding stock that expires within 30 days."
  },
  "tags": []
}
