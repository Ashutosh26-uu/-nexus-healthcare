# Copy this file to server/.env and fill in what you need. Everything is optional for local demos.

PORT=4000
NODE_ENV=development
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-this-to-a-long-random-string

# ───────────── Database ─────────────
# Default: SQLite file at server/data/omnicare.db (no setup).
# SQLITE_FILE=./data/omnicare.db
# Production: PostgreSQL (Supabase, Neon, AWS RDS, Azure…). Also run: npm install pg --prefix server
# DATABASE_URL=postgres://user:password@host:5432/omnicare?sslmode=require

# ───────────── One-time passcodes (OTP) ─────────────
# auto = first configured provider below; console = print codes in the server log (dev only)
OTP_PROVIDER=auto
# Show codes on screen. Defaults to true only when no real provider is configured. Always false in production.
# OTP_DEV_MODE=false
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# Twilio Verify — global SMS + WhatsApp, Twilio generates and checks the code (recommended for global)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Messaging — if you prefer sending our own message text (set TWILIO_FROM or a messaging service)
# TWILIO_FROM=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=+14155238886

# MSG91 — cheapest for India; needs a DLT-approved OTP template with ##OTP## variable
# MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Email codes over SMTP (Gmail app password, SendGrid, Amazon SES, Zoho…)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=xxxxxxxx
# SMTP_FROM=Nexus Healthcare <no-reply@yourdomain.com>

# ───────────── AI & translation ─────────────
# Enables Claude answers in the Saathi chat AND automatic translation into all 71 languages.
# ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-opus-5-5
# I18N_MODEL=claude-opus-5-5
# Other translation providers (tried in this order after Claude):
# GOOGLE_TRANSLATE_API_KEY=...
# LIBRETRANSLATE_URL=https://your-libretranslate-host
# LIBRETRANSLATE_API_KEY=...
# I18N_PROVIDERS=claude,google,libretranslate

# ───────────── Uploads ─────────────
MAX_UPLOAD_MB=10

# ───────────── Automations (n8n) — see AUTOMATIONS.md ─────────────
# Nexus → n8n: signed events (booking paid, lab report ready, new medicine order…). Off until both are set.
# N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/nexus-events
# N8N_WEBHOOK_SECRET=at-least-24-random-characters   (also the n8n Header Auth value for X-Nexus-Token)
# Only send some events (comma-separated). Default: all.
# N8N_EVENTS=booking.confirmed,lab.report_ready,onboarding.submitted,payment.refund_due
# Add patient first name, mobile and email to events (needed for WhatsApp/SMS reminders). Medical details are never sent.
# N8N_SHARE_CONTACT=false
# n8n → Nexus: key for /api/automation/* (summaries, upcoming visits, low stock, in-app notices). 32+ characters.
# N8N_API_KEY=
